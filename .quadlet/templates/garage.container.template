# ~/.config/containers/systemd/garage.container

[Unit]
Description=garage container
After=network-online.target

[Container]
ContainerName=garage
Image=docker.io/dxflrs/garage:v2.5.0
PublishPort=3900:3900
PublishPort=3903:3903
Volume=garage-data.volume:/var/lib/garage
Volume=%h/.config/containers/systemd/garage/garage.toml:/etc/garage.toml:ro,Z

[Service]
Restart=always

[Install]
WantedBy=default.target